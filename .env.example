# OmniData 环境配置文件示例
# 复制此文件为 .env 并根据需要修改配置

# 应用配置
OMNIDATA_APP_NAME=OmniData
OMNIDATA_APP_VERSION=0.1.0
OMNIDATA_DEBUG=false


# 浏览器配置
OMNIDATA_BROWSER__HEADLESS=true
OMNIDATA_BROWSER__POOL_INITIAL_SIZE=2
OMNIDATA_BROWSER__IDLE_TIMEOUT=300
OMNIDATA_BROWSER__LAUNCH_TIMEOUT=30

# 爬虫配置

# Redis 配置
OMNIDATA_REDIS__HOST=localhost
OMNIDATA_REDIS__PORT=6379
OMNIDATA_REDIS__DB=0
OMNIDATA_REDIS__PASSWORD=your_password
OMNIDATA_REDIS__MAX_CONNECTIONS=10
OMNIDATA_REDIS__SOCKET_TIMEOUT=5
OMNIDATA_REDIS__SOCKET_CONNECT_TIMEOUT=5
OMNIDATA_REDIS__DECODE_RESPONSES=true

# 认证配置（可选）
# 设置后将启用 API KEY 保护中间件，所有请求需要在请求头中携带 X-API-Key
# OMNIDATA_AUTH__API_KEY=your-secret-api-key

# 登录器配置
# 登录状态检查的最大并发数
OMNIDATA_LOGIN__CHECK_CONCURRENCY=5
# 单次检查的超时时间（秒）
OMNIDATA_LOGIN__CHECK_TIMEOUT=30
